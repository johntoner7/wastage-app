# Copy this file to .env and fill in your own Supabase project's values.
# Find both on your project's dashboard under Settings → API.
#
# The anon key is safe to expose in client-side code — it's the table's
# row-level security policies (see sql/schema.sql) that control what it
# can actually do, not keeping the key secret.

VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key
