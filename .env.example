# Copy this file to .env and fill in your own Worker API's values.
# See worker/README.md for how to deploy the API and get these.
#
# The token is safe to expose in client-side code — it's not meaningfully
# secret, since it ships inside the app's built JavaScript. It just keeps
# the API from being wide open to anyone who finds the URL.

VITE_API_URL=https://wastage-api.your-subdomain.workers.dev
VITE_API_TOKEN=your-api-token
